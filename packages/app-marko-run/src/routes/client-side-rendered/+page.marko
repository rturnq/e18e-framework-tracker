static function generateData() {
  return Array.from({ length: 1000 }, () => ({
    id: crypto.randomUUID(),
    name: crypto.randomUUID(),
  }));
}

<let/entries=[]>
<script>
  entries = generateData();
</script>

<table>
  <tbody>
    <for|entry| of=entries by=(entry) => entry.id>
      <tr>
        <td>${entry.id}</td>
        <td>${entry.name}</td>
        <td><a href=`/client-side-rendered/${entry.id}`>View →</a></td>
      </tr>
    </for>
  </tbody>
</table>
