<table>
  <tbody>
    <await|entries|=$global.data.entries>
      <for|entry| of=entries>
        <tr>
          <td>${entry.id}</td>
          <td>${entry.name}</td>
          <td><a href=`/server-side-rendered/${entry.id}`>View →</a></td>
        </tr>
      </for>
    </await>
  </tbody>
</table>
